    "def predictive_draws(fitted, feature_names, frame_features, frame, seed):\n",
    "    posterior = fitted.posterior.stack(sample=('chain', 'draw'))\n",
    "    alpha = posterior['alpha'].transpose('sample').to_numpy()\n",
    "    beta = posterior['beta'].transpose('sample', 'feature').to_numpy()\n",
    "    sigma = posterior['sigma'].transpose('sample').to_numpy()\n",
    "    mu = alpha[:, None] + beta @ frame_features[feature_names].to_numpy().T\n",
    "    generator = np.random.default_rng(seed)\n",
    "    if 'neighborhood_effect' in posterior:\n",
    "        effects = posterior['neighborhood_effect'].transpose('sample', 'neighborhood').to_numpy()\n",
    "        indices = frame['Neighborhood'].map(neighborhood_index).fillna(-1).to_numpy(dtype=int)\n",
    "        known = indices >= 0\n",
    "        mu[:, known] += effects[:, indices[known]]\n",
    "        for neighborhood in frame.loc[~known, 'Neighborhood'].unique():\n",
    "            same_group = frame['Neighborhood'].eq(neighborhood).to_numpy()\n",
    "            group_sd = posterior['neighborhood_sd'].transpose('sample').to_numpy()\n",
    "            new_effect = generator.normal(0, group_sd)\n",
    "            mu[:, same_group] += new_effect[:, None]\n",
    "    log_predictions = generator.normal(mu, sigma[:, None])\n",
    "    price_predictions = np.exp(log_predictions)\n",
    "    expected_price = np.exp(mu + 0.5 * sigma[:, None] ** 2).mean(axis=0)\n",
    "    return mu, log_predictions, price_predictions, expected_price\n",
    "\n",
    "predictions = {}\n",
    "metric_records = []\n",
    "for name, fitted, feature_names, seed in [\n",
    "    ('Baseline', baseline_fit, baseline_features, SEED + 1),\n",
    "    ('Expanded', expanded_fit, expanded_features, SEED + 2)\n",
    "]:\n",
    "    mu, log_draws, price_draws, mean_price = predictive_draws(\n",
    "        fitted, feature_names, X_holdout, holdout_df, seed\n",
    "    )\n",
    "    lower, median, upper = np.quantile(price_draws, [0.05, 0.50, 0.95], axis=0)\n",
    "    table = pd.DataFrame({\n",
    "        'Id': holdout_df['Id'].to_numpy(), 'actual_price': y_holdout,\n",
    "        'predicted_mean': mean_price, 'predicted_median': median,\n",
    "        'lower_90': lower, 'upper_90': upper\n",
    "    })\n",
    "    predictions[name] = {'table': table, 'mu': mu, 'log_draws': log_draws}\n",
    "    metric_records.append({\n",
    "        'model': name,\n",
    "        'RMSE_dollars': np.sqrt(np.mean((y_holdout - mean_price) ** 2)),\n",
    "        'MAE_dollars': np.mean(np.abs(y_holdout - mean_price)),\n",
    "        'log_RMSE': np.sqrt(np.mean((np.log(y_holdout) - np.log(mean_price)) ** 2)),\n",
    "        'coverage_90_pct': 100 * np.mean((y_holdout >= lower) & (y_holdout <= upper)),\n",
    "        'mean_interval_width_dollars': np.mean(upper - lower),\n",
    "    })\n",
    "    table.to_csv(results_path / f'{name.lower()}_holdout_predictions.csv', index=False)\n",
    "comparison = pd.DataFrame(metric_records).set_index('model')\n",
    "display(comparison.round(3))\n",
    "comparison.to_csv(results_path / 'model_comparison.csv')\n",
    "\n",
    "# Posterior predictive checks on the training sample.\n",
    "training_log_predictions = {}\n",
    "for name, fitted, feature_names, seed in [\n",
    "    ('Baseline', baseline_fit, baseline_features, SEED + 3),\n",
    "    ('Expanded', expanded_fit, expanded_features, SEED + 4)\n",
    "]:\n",
    "    _, log_draws, _, _ = predictive_draws(fitted, feature_names, X_train, screening_df, seed)\n",
    "    training_log_predictions[name] = log_draws\n",
    "    draw_statistics = pd.DataFrame({\n",
    "        'mean_log_price': log_draws.mean(axis=1),\n",
    "        'sd_log_price': log_draws.std(axis=1),\n",
    "    }).quantile([0.05, 0.50, 0.95])\n",
    "    print(name + ': replicated training-data statistics')\n",
    "    display(draw_statistics.round(3))\n",
    "print('Observed mean and SD of log price:', round(y_train.mean(), 3), round(y_train.std(), 3))\n"
