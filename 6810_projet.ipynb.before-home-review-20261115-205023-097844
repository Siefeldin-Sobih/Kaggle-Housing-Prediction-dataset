    "fig, axes = plt.subplots(1, 2, figsize=(12, 4))\n",
    "for ax, name, prior in zip(axes, ['Baseline', 'Expanded'], [baseline_prior, expanded_prior]):\n",
    "    prior_values = prior.prior_predictive['log_price_obs'].to_numpy().ravel()\n",
    "    ax.hist(prior_values, bins=80, density=True, alpha=0.45, label='Prior predictions')\n",
    "    ax.hist(y_train, bins=40, density=True, alpha=0.65, label='Observed')\n",
    "    ax.set(title=name + ': prior predictive distribution', xlabel='log(SalePrice)', ylabel='Density')\n",
    "    ax.legend()\n",
    "plt.tight_layout()\n",
    "plt.savefig(results_path / 'prior_predictive.png', dpi=140)\n",
    "plt.show()\n",
    "\n",
    "for name, fitted in fits.items():\n",
    "    variables = ['alpha', 'sigma'] + (['neighborhood_sd'] if name == 'Expanded' else [])\n",
    "    az.plot_trace(fitted, var_names=variables)\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(results_path / f'{name.lower()}_trace.png', dpi=140)\n",
    "    plt.show()\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(12, 4))\n",
    "for ax, name in zip(axes, ['Baseline', 'Expanded']):\n",
    "    ax.hist(y_train, bins=40, density=True, alpha=0.65, label='Observed')\n",
    "    draws = training_log_predictions[name]\n",
    "    for index in np.linspace(0, len(draws) - 1, 30, dtype=int):\n",
    "        sns.kdeplot(draws[index], ax=ax, color='teal', alpha=0.10, linewidth=0.8)\n",
    "    ax.set(title=name + ': posterior predictive check', xlabel='log(SalePrice)', ylabel='Density')\n",
    "    ax.legend()\n",
    "plt.tight_layout()\n",
    "plt.savefig(results_path / 'posterior_predictive.png', dpi=140)\n",
    "plt.show()\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(12, 5))\n",
    "for ax, name in zip(axes, ['Baseline', 'Expanded']):\n",
    "    table = predictions[name]['table']\n",
    "    ax.scatter(table['actual_price'], table['predicted_mean'], alpha=0.5, s=18)\n",
    "    limits = [min(table['actual_price'].min(), table['predicted_mean'].min()),\n",
    "              max(table['actual_price'].max(), table['predicted_mean'].max())]\n",
    "    ax.plot(limits, limits, '--', color='darkred')\n",
    "    ax.set(title=name + ': held-out predictions', xlabel='Actual price ($)', ylabel='Predicted mean ($)')\n",
    "plt.tight_layout()\n",
    "plt.savefig(results_path / 'holdout_predictions.png', dpi=140)\n",
    "plt.show()\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "for ax, name in zip(axes, ['Baseline', 'Expanded']):\n",
    "    table = predictions[name]['table'].sort_values('actual_price')\n",
    "    selected = table.iloc[np.linspace(0, len(table) - 1, 40, dtype=int)]\n",
    "    x = np.arange(len(selected))\n",
    "    ax.vlines(x, selected['lower_90'], selected['upper_90'], color='steelblue', alpha=0.7)\n",
    "    ax.scatter(x, selected['predicted_mean'], color='steelblue', s=18, label='Predicted mean')\n",
    "    ax.scatter(x, selected['actual_price'], color='darkred', s=18, label='Actual price')\n",
    "    ax.set(title=name + ': 90% prediction intervals', xlabel='40 held-out homes, ordered by actual price', ylabel='Price ($)')\n",
    "    ax.legend()\n",
    "plt.tight_layout()\n",
    "plt.savefig(results_path / 'prediction_intervals.png', dpi=140)\n",
    "plt.show()\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(12, 5))\n",
    "for ax, name in zip(axes, ['Baseline', 'Expanded']):\n",
    "    mu = predictions[name]['mu'].mean(axis=0)\n",
    "    residual = np.log(y_holdout) - mu\n",
    "    ax.scatter(mu, residual, alpha=0.45, s=18)\n",
    "    ax.axhline(0, color='darkred', linestyle='--')\n",
    "    ax.set(title=name + ': held-out log residuals', xlabel='Predicted log price', ylabel='Observed minus predicted log price')\n",
    "plt.tight_layout()\n",
    "plt.savefig(results_path / 'holdout_residuals.png', dpi=140)\n",
    "plt.show()\n",
    "\n",
    "# Neighborhood effects relative to the shared intercept.\n",
    "effect_samples = expanded_fit.posterior['neighborhood_effect'].stack(sample=('chain', 'draw')).transpose('sample', 'neighborhood').to_numpy()\n",
    "effect_percent = 100 * np.expm1(effect_samples)\n",
    "effect_lower, effect_median, effect_upper = np.quantile(effect_percent, [0.05, 0.50, 0.95], axis=0)\n",
    "neighborhood_effects = pd.DataFrame({\n",
    "    'Neighborhood': neighborhood_names,\n",
    "    'n_training': screening_df['Neighborhood'].value_counts().reindex(neighborhood_names).to_numpy(),\n",
    "    'median_effect_pct': effect_median,\n",
    "    'lower_90_pct': effect_lower, 'upper_90_pct': effect_upper\n",
    "}).sort_values('median_effect_pct')\n",
    "display(neighborhood_effects.round(2))\n",
    "neighborhood_effects.to_csv(results_path / 'neighborhood_effects.csv', index=False)\n",
    "fig, ax = plt.subplots(figsize=(9, 8))\n",
    "positions = np.arange(len(neighborhood_effects))\n",
    "ax.hlines(positions, neighborhood_effects['lower_90_pct'], neighborhood_effects['upper_90_pct'], color='teal')\n",
    "ax.scatter(neighborhood_effects['median_effect_pct'], positions, color='teal', s=20)\n",
    "ax.set_yticks(positions, [f'{row.Neighborhood} (n={row.n_training})' for row in neighborhood_effects.itertuples()])\n",
    "ax.axvline(0, linestyle='--', color='darkred')\n",
    "ax.set(title='Partially pooled neighborhood effects: 90% credible intervals', xlabel='Price difference relative to shared intercept (%)')\n",
    "plt.tight_layout()\n",
    "plt.savefig(results_path / 'neighborhood_effects.png', dpi=140)\n",
    "plt.show()\n"
