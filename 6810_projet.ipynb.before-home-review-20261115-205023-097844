    "CHAINS = 4\n",
    "DRAWS = 1000\n",
    "TUNE = 1500\n",
    "TARGET_ACCEPT = 0.95\n",
    "SEED = 6810\n",
    "\n",
    "def fit_price_model(feature_names, hierarchical=False):\n",
    "    coords = {'feature': feature_names, 'home': screening_df['Id'].to_numpy()}\n",
    "    if hierarchical:\n",
    "        coords['neighborhood'] = neighborhood_names\n",
    "    with pm.Model(coords=coords) as model:\n",
    "        alpha = pm.Normal('alpha', mu=float(y_train.mean()), sigma=0.7)\n",
    "        beta = pm.Normal('beta', mu=0.0, sigma=0.5, dims='feature')\n",
    "        sigma = pm.HalfNormal('sigma', sigma=0.5)\n",
    "        mu = alpha + pm.math.dot(X_train[feature_names].to_numpy(), beta)\n",
    "        if hierarchical:\n",
    "            neighborhood_sd = pm.HalfNormal('neighborhood_sd', sigma=0.3)\n",
    "            neighborhood_z = pm.ZeroSumNormal('neighborhood_z', sigma=1.0,\n",
    "                                              dims='neighborhood')\n",
    "            effects = pm.Deterministic('neighborhood_effect',\n",
    "                                       neighborhood_z * neighborhood_sd,\n",
    "                                       dims='neighborhood')\n",
    "            mu = mu + effects[train_neighborhood]\n",
    "        pm.Normal('log_price_obs', mu=mu, sigma=sigma, observed=y_train, dims='home')\n",
    "        prior = pm.sample_prior_predictive(draws=200, random_seed=SEED)\n",
    "        posterior = pm.sample(\n",
    "            draws=DRAWS, tune=TUNE, chains=CHAINS, cores=2,\n",
    "            target_accept=TARGET_ACCEPT, random_seed=SEED,\n",
    "            blas_cores=1, progressbar=True\n",
    "        )\n",
    "    return model, posterior, prior\n",
    "\n",
    "baseline_model, baseline_fit, baseline_prior = fit_price_model(baseline_features)\n",
    "expanded_model, expanded_fit, expanded_prior = fit_price_model(expanded_features, hierarchical=True)\n",
    "\n",
    "fits = {'Baseline': baseline_fit, 'Expanded': expanded_fit}\n",
    "for name, fitted in fits.items():\n",
    "    fitted.posterior.to_netcdf(results_path / f'{name.lower()}_posterior.nc', engine='scipy')\n",
    "    fitted.sample_stats.to_netcdf(results_path / f'{name.lower()}_sample_stats.nc', engine='scipy')\n",
    "\n",
    "diagnostic_records = []\n",
    "for name, fitted in fits.items():\n",
    "    variables = ['alpha', 'beta', 'sigma']\n",
    "    if name == 'Expanded':\n",
    "        variables += ['neighborhood_sd', 'neighborhood_z']\n",
    "    summary = az.summary(fitted, var_names=variables, hdi_prob=0.90, round_to=4)\n",
    "    summary.to_csv(results_path / f'{name.lower()}_parameter_summary.csv')\n",
    "    max_rhat = float(az.rhat(fitted, var_names=variables).to_array().max())\n",
    "    min_bulk_ess = float(az.ess(fitted, var_names=variables, method='bulk').to_array().min())\n",
    "    min_tail_ess = float(az.ess(fitted, var_names=variables, method='tail').to_array().min())\n",
    "    divergences = int(fitted.sample_stats['diverging'].sum())\n",
    "    diagnostic_records.append({\n",
    "        'model': name, 'max_rhat': max_rhat, 'min_bulk_ess': min_bulk_ess,\n",
    "        'min_tail_ess': min_tail_ess, 'divergences': divergences,\n",
    "        'sampling_check': max_rhat < 1.01 and min_bulk_ess >= 400\n",
    "                          and min_tail_ess >= 400 and divergences == 0\n",
    "    })\n",
    "diagnostics = pd.DataFrame(diagnostic_records)\n",
    "display(diagnostics.round(3))\n",
    "diagnostics.to_csv(results_path / 'sampling_diagnostics.csv', index=False)\n"
