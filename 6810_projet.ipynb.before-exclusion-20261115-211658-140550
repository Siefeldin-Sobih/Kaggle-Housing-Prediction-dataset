  {
   "cell_type": "code",
   "id": "model-inputs",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-11-16T03:52:08.935896Z",
     "iopub.status.busy": "2026-11-16T03:52:08.935247Z",
