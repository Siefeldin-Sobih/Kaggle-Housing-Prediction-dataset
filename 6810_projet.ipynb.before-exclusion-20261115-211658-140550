    "# Neighborhood effects relative to the shared intercept.\n",
    "effect_samples = expanded_fit.posterior['neighborhood_effect'].stack(sample=('chain', 'draw')).transpose('sample', 'neighborhood').to_numpy()\n",
    "effect_percent = 100 * np.expm1(effect_samples)\n",
    "effect_lower, effect_median, effect_upper = np.quantile(effect_percent, [0.05, 0.50, 0.95], axis=0)\n",
    "neighborhood_effects = pd.DataFrame({\n",
    "    'Neighborhood': neighborhood_names,\n",
    "    'n_training': screening_df['Neighborhood'].value_counts().reindex(neighborhood_names).to_numpy(),\n",
    "    'median_effect_pct': effect_median,\n",
    "    'lower_90_pct': effect_lower, 'upper_90_pct': effect_upper\n",
    "}).sort_values('median_effect_pct')\n",
    "display(neighborhood_effects.round(2))\n",
    "neighborhood_effects.to_csv(results_path / 'neighborhood_effects.csv', index=False)\n",
    "fig, ax = plt.subplots(figsize=(9, 8))\n",
    "positions = np.arange(len(neighborhood_effects))\n",
    "ax.hlines(positions, neighborhood_effects['lower_90_pct'], neighborhood_effects['upper_90_pct'], color='teal')\n",
    "ax.scatter(neighborhood_effects['median_effect_pct'], positions, color='teal', s=20)\n",
    "ax.set_yticks(positions, [f'{row.Neighborhood} (n={row.n_training})' for row in neighborhood_effects.itertuples()])\n",
    "ax.axvline(0, linestyle='--', color='darkred')\n",
    "ax.set(title='Partially pooled neighborhood effects: 90% credible intervals', xlabel='Price difference relative to shared intercept (%)')\n",
    "plt.tight_layout()\n",
    "plt.savefig(results_path / 'neighborhood_effects.png', dpi=140)\n",
    "plt.show()\n"
