  {
   "cell_type": "code",
   "id": "score-predictors",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-11-16T03:52:04.003865Z",
     "iopub.status.busy": "2026-11-16T03:52:04.003552Z",
