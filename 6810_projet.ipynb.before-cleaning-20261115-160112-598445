    "# Work with the candidate predictors from your proposal\n",
    "numeric_predictors = [\n",
    "    \"GrLivArea\", \"OverallQual\", \"YearBuilt\",\n",
    "    \"LotArea\", \"GarageCars\"\n",
    "]\n",
    "\n",
    "eda = train_df[\n",
    "    [\"SalePrice\", \"Neighborhood\"] + numeric_predictors\n",
    "].copy()\n",
    "eda[\"LogSalePrice\"] = np.log(eda[\"SalePrice\"])\n",
    "\n",
    "# 1. Compare numeric associations with raw and log price.\n",
    "# Spearman captures monotonic relationships; Pearson captures linear ones.\n",
    "associations = pd.DataFrame({\n",
    "    \"Pearson: price\": eda[numeric_predictors].corrwith(\n",
    "        eda[\"SalePrice\"], method=\"pearson\"\n",
    "    ),\n",
    "    \"Pearson: log price\": eda[numeric_predictors].corrwith(\n",
    "        eda[\"LogSalePrice\"], method=\"pearson\"\n",
    "    ),\n",
    "    \"Spearman: price\": eda[numeric_predictors].corrwith(\n",
    "        eda[\"SalePrice\"], method=\"spearman\"\n",
    "    )\n",
    "})\n",
    "\n",
    "display(\n",
    "    associations.loc[\n",
    "        associations[\"Pearson: log price\"]\n",
    "        .abs().sort_values(ascending=False).index\n",
    "    ].round(3)\n",
    ")\n",
    "\n",
    "# 2. Inspect relationships with log price.\n",
    "fig, axes = plt.subplots(2, 3, figsize=(15, 9))\n",
    "\n",
    "for ax, variable in zip(axes.flat, numeric_predictors):\n",
    "    if variable in [\"OverallQual\", \"GarageCars\"]:\n",
    "        sns.boxplot(data=eda, x=variable, y=\"LogSalePrice\", ax=ax)\n",
    "    else:\n",
    "        sns.regplot(\n",
    "            data=eda, x=variable, y=\"LogSalePrice\",\n",
    "            scatter_kws={\"alpha\": 0.3},\n",
    "            line_kws={\"color\": \"red\"},\n",
    "            ci=None, ax=ax\n",
    "        )\n",
    "    ax.set_title(variable)\n",
    "\n",
    "axes.flat[-1].axis(\"off\")\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# 3. Check overlap among numeric predictors.\n",
    "plt.figure(figsize=(8, 6))\n",
    "sns.heatmap(\n",
    "    eda[numeric_predictors].corr(),\n",
    "    annot=True, fmt=\".2f\", cmap=\"coolwarm\",\n",
    "    vmin=-1, vmax=1\n",
    ")\n",
    "plt.title(\"Correlations among candidate predictors\")\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# 4. Inspect neighborhood differences and sample sizes.\n",
    "neighborhood_summary = (\n",
