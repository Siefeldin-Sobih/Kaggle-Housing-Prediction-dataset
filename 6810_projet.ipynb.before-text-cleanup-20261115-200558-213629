   "source": [
    "# Show the strongest associations separately for numeric and categorical predictors.\n",
    "numeric_results = screening_results[screening_results['type'].eq('Numeric / ordered')].copy()\n",
    "numeric_results['abs_pearson_log'] = numeric_results['pearson_log_price'].abs()\n",
    "numeric_top = numeric_results.nlargest(15, 'abs_pearson_log').sort_values('abs_pearson_log')\n",
    "categorical_top = screening_results[screening_results['type'].eq('Categorical')].nlargest(15, 'eta2_log_price').sort_values('eta2_log_price')\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 6))\n",
    "axes[0].barh(numeric_top['variable'], numeric_top['abs_pearson_log'], color='steelblue')\n",
    "axes[0].axvline(PEARSON_CUTOFF, color='darkred', linestyle='--')\n",
    "axes[0].set(title='Numeric predictors: top 15', xlabel='Absolute Pearson correlation with log price')\n",
    "axes[1].barh(categorical_top['variable'], categorical_top['eta2_log_price'], color='teal')\n",
    "axes[1].axvline(ETA_SQUARED_CUTOFF, color='darkred', linestyle='--')\n",
    "axes[1].set(title='Categorical predictors: top 15', xlabel='Eta-squared with log price')\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# Compare raw and log-price relationships for the original numeric candidates.\n",
    "numeric_candidates = [v for v in ORIGINAL_CANDIDATES if v != 'Neighborhood']\n",
    "fig, axes = plt.subplots(len(numeric_candidates), 2, figsize=(12, 16))\n",
    "for row, variable in enumerate(numeric_candidates):\n",
    "    for col, (response, label) in enumerate([\n",
    "        (screening_df['SalePrice'], 'SalePrice ($)'), (log_price, 'log(SalePrice)')\n",
    "    ]):\n",
    "        sns.regplot(x=screening_df[variable], y=response, ci=None,\n",
    "                    scatter_kws={'alpha': 0.25, 's': 12},\n",
    "                    line_kws={'color': 'darkred'}, ax=axes[row, col])\n",
    "        axes[row, col].set(xlabel=variable, ylabel=label)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# Neighborhood is categorical: display distributions and group sizes.\n",
    "neighborhood_data = screening_df[['Neighborhood', 'SalePrice']].copy()\n",
    "neighborhood_data['LogSalePrice'] = log_price\n",
    "neighborhood_summary = neighborhood_data.groupby('Neighborhood').agg(\n",
    "    n=('SalePrice', 'size'), median_price=('SalePrice', 'median'),\n",
    "    median_log_price=('LogSalePrice', 'median')\n",
    ").sort_values('median_price')\n",
    "display(neighborhood_summary)\n",
    "plt.figure(figsize=(13, 5))\n",
    "sns.boxplot(data=neighborhood_data, x='Neighborhood', y='LogSalePrice',\n",
    "            order=neighborhood_summary.index)\n",
    "plt.xticks(rotation=90)\n",
    "plt.title('Neighborhood: log-price distributions (unadjusted for house characteristics)')\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# Check overlapping information among numeric variables passing the screen.\n",
    "selected_numeric = numeric_results.loc[numeric_results['passes_screen'], 'variable'].tolist()\n",
    "if len(selected_numeric) > 1:\n",
    "    plt.figure(figsize=(12, 10))\n",
    "    sns.heatmap(screening_df[selected_numeric].corr(), cmap='coolwarm', vmin=-1, vmax=1)\n",
    "    plt.title('Correlation among shortlisted numeric predictors')\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n"
