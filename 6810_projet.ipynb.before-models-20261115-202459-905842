   "source": [
    "## Price distributions and predictor screening\n",
    "\n",
    "- Training sample: 80%; held-out sample: 20%; random seed: 6810.\n",
    "- Missingness cutoff: exclude predictors with more than 40% missing values.\n",
    "- Numeric screening: absolute Pearson correlation with log sale price at least 0.30.\n",
    "- Categorical screening: eta-squared with log sale price at least 0.10.\n",
    "- Associations use available observations for each predictor.\n",
    "- Results compare the six proposed predictors with the other 73 predictors.\n"
   ]
  },
  {
   "cell_type": "code",
   "id": "screening-setup",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-11-16T03:02:20.702133107Z",
     "start_time": "2026-11-16T03:02:20.658092302Z"
    }
   },
   "source": [
    "# Screening thresholds.\n",
    "MISSING_CUTOFF = 0.40\n",
    "PEARSON_CUTOFF = 0.30\n",
    "ETA_SQUARED_CUTOFF = 0.10\n",
    "ORIGINAL_CANDIDATES = [\n",
    "    'GrLivArea', 'OverallQual', 'YearBuilt',\n",
    "    'LotArea', 'GarageCars', 'Neighborhood'\n",
    "]\n",
    "\n",
    "# Split labeled homes into training and held-out samples.\n",
    "rng = np.random.default_rng(6810)\n",
    "row_order = rng.permutation(len(train_df))\n",
    "n_holdout = int(np.ceil(0.20 * len(train_df)))\n",
    "holdout_df = train_df.iloc[row_order[:n_holdout]].copy()\n",
    "screening_df = train_df.iloc[row_order[n_holdout:]].copy()\n",
    "assert screening_df['SalePrice'].gt(0).all()\n",
    "log_price = np.log(screening_df['SalePrice'])\n",
    "print(f'Screening: {len(screening_df)} homes; held out: {len(holdout_df)} homes.')\n",
    "predictor_columns = [c for c in screening_df.columns if c not in ['Id', 'SalePrice']]\n"
   ],
   "outputs": [],
   "execution_count": null
