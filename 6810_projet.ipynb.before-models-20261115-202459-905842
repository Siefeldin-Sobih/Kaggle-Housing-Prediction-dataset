   "id": "absence-notes",
   "metadata": {},
   "source": [
    "## Data cleaning\n",
    "\n",
    "Absence categories follow `data_description.txt`. Basement, garage, fireplace, pool, and miscellaneous-feature labels use the corresponding size or count to confirm absence.\n",
    "\n",
    "The masonry-veneer category `None` is preserved. Unresolved entries appear in the audit table. Cleaned datasets and audits are saved in the data folder.\n"
   ]
  },
  {
   "cell_type": "code",
   "id": "clean-absence",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-11-16T03:02:20.591297896Z",
     "start_time": "2026-11-16T03:02:20.380769927Z"
    }
   },
   "source": [
    "# Recode confirmed absence categories.\n",
    "# Confirm absence using size/count columns.\n",
    "absence_rules = {\n",
    "    'Alley': ('No alley access', None),\n",
    "    'BsmtQual': ('No basement', 'TotalBsmtSF'),\n",
    "    'BsmtCond': ('No basement', 'TotalBsmtSF'),\n",
    "    'BsmtExposure': ('No basement', 'TotalBsmtSF'),\n",
    "    'BsmtFinType1': ('No basement', 'TotalBsmtSF'),\n",
    "    'BsmtFinType2': ('No basement', 'TotalBsmtSF'),\n",
    "    'FireplaceQu': ('No fireplace', 'Fireplaces'),\n",
    "    'GarageType': ('No garage', 'GarageCars'),\n",
    "    'GarageFinish': ('No garage', 'GarageCars'),\n",
    "    'GarageQual': ('No garage', 'GarageCars'),\n",
    "    'GarageCond': ('No garage', 'GarageCars'),\n",
    "    'PoolQC': ('No pool', 'PoolArea'),\n",
    "    'Fence': ('No fence', None),\n",
    "    'MiscFeature': ('No miscellaneous feature', 'MiscVal'),\n",
    "}\n",
    "\n",
    "def clean_absences(frame, dataset_name):\n",
    "    cleaned = frame.copy()\n",
    "    audit = []\n",
    "    conflicts = []\n",
    "    for column, (label, companion) in absence_rules.items():\n",
    "        missing = cleaned[column].isna()\n",
    "        if companion is None:\n",
    "            confirmed_absent = missing\n",
    "        else:\n",
    "            confirmed_absent = missing & cleaned[companion].eq(0)\n",
    "            if companion == 'GarageCars':\n",
    "                confirmed_absent &= cleaned['GarageArea'].eq(0)\n",
    "        cleaned.loc[confirmed_absent, column] = label\n",
    "        unresolved = missing & ~confirmed_absent\n",
    "        audit.append({\n",
    "            'dataset': dataset_name,\n",
    "            'variable': column,\n",
    "            'missing_before': int(missing.sum()),\n",
    "            'recoded_as_absent': int(confirmed_absent.sum()),\n",
    "            'still_missing': int(unresolved.sum()),\n",
    "        })\n",
    "        for _, row in cleaned.loc[unresolved].iterrows():\n",
    "            conflicts.append({\n",
    "                'dataset': dataset_name, 'Id': row['Id'],\n",
    "                'variable': column, 'check_column': companion,\n",
    "                'check_value': row[companion] if companion else None,\n",
    "            })\n",
    "    return cleaned, audit, conflicts\n",
    "\n",
    "# Keep raw copies for comparison.\n",
    "train_raw_df = train_df.copy()\n",
    "test_raw_df = test_df.copy()\n",
    "train_df, train_audit, train_conflicts = clean_absences(train_raw_df, 'train')\n",
    "test_df, test_audit, test_conflicts = clean_absences(test_raw_df, 'test')\n",
    "\n",
    "absence_audit = pd.DataFrame(train_audit + test_audit)\n",
    "unresolved_absences = pd.DataFrame(\n",
    "    train_conflicts + test_conflicts,\n",
    "    columns=['dataset', 'Id', 'variable', 'check_column', 'check_value']\n",
    ")\n",
    "display(absence_audit)\n",
    "if not unresolved_absences.empty:\n",
    "    print('Unresolved entries:')\n",
    "    display(unresolved_absences)\n",
    "\n",
    "# Export cleaned datasets and audits.\n",
    "train_df.to_csv(path / 'train_cleaned.csv', index=False, na_rep='NA')\n",
    "test_df.to_csv(path / 'test_cleaned.csv', index=False, na_rep='NA')\n",
    "absence_audit.to_csv(path / 'absence_cleaning_audit.csv', index=False)\n",
    "unresolved_absences.to_csv(path / 'absence_unresolved.csv', index=False)\n",
    "print('Saved train_cleaned.csv, test_cleaned.csv, and cleaning audit files.')\n"
   ],
   "outputs": [],
   "execution_count": null
  },
