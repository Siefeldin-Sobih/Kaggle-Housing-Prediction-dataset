   "cell_type": "markdown",
   "id": "prediction-function-intro",
   "metadata": {},
   "source": [
    "## Generate price predictions\n",
    "\n",
    "Draw predicted prices from the fitted models, including residual variation, so we can calculate prediction intervals.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "prediction-function",
   "metadata": {},
   "outputs": [],
   "source": [
    "def predictive_draws(fitted, feature_names, frame_features, frame, seed):\n",
    "    posterior = fitted.posterior.stack(sample=('chain', 'draw'))\n",
    "    alpha = posterior['alpha'].transpose('sample').to_numpy()\n",
    "    beta = posterior['beta'].transpose('sample', 'feature').to_numpy()\n",
    "    sigma = posterior['sigma'].transpose('sample').to_numpy()\n",
    "    mu = alpha[:, None] + beta @ frame_features[feature_names].to_numpy().T\n",
    "    generator = np.random.default_rng(seed)\n",
    "    if 'neighborhood_effect' in posterior:\n",
    "        effects = posterior['neighborhood_effect'].transpose('sample', 'neighborhood').to_numpy()\n",
    "        indices = frame['Neighborhood'].map(neighborhood_index).fillna(-1).to_numpy(dtype=int)\n",
    "        known = indices >= 0\n",
    "        mu[:, known] += effects[:, indices[known]]\n",
    "        for neighborhood in frame.loc[~known, 'Neighborhood'].unique():\n",
    "            same_group = frame['Neighborhood'].eq(neighborhood).to_numpy()\n",
    "            group_sd = posterior['neighborhood_sd'].transpose('sample').to_numpy()\n",
    "            new_effect = generator.normal(0, group_sd)\n",
    "            mu[:, same_group] += new_effect[:, None]\n",
    "    log_predictions = generator.normal(mu, sigma[:, None])\n",
    "    price_predictions = np.exp(log_predictions)\n",
    "    expected_price = np.exp(mu + 0.5 * sigma[:, None] ** 2).mean(axis=0)\n",
    "    return mu, log_predictions, price_predictions, expected_price\n"
   ]
  },
  {
