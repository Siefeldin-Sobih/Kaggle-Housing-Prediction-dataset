  {
   "cell_type": "markdown",
   "id": "score-predictors-intro",
   "metadata": {},
   "source": [
    "## Score all predictors\n",
    "\n",
    "Calculate Pearson and Spearman correlations for numeric predictors, and eta-squared for categorical predictors.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "score-predictors",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Categorical code columns.\n",
    "categorical_codes = {'MSSubClass', 'MoSold'}\n",
    "predictor_columns = [c for c in screening_df.columns if c not in ['Id', 'SalePrice']]\n",
    "assert len(predictor_columns) == 79\n",
    "\n",
    "def eta_squared(groups, response):\n",
    "    \"\"\"Fraction of response variation between category means.\"\"\"\n",
    "    table = pd.DataFrame({'group': groups, 'response': response}).dropna()\n",
    "    grouped = table.groupby('group', observed=True)['response']\n",
    "    total = ((table['response'] - table['response'].mean()) ** 2).sum()\n",
    "    counts = grouped.size()\n",
    "    if len(counts) < 2 or total == 0:\n",
    "        return np.nan, len(counts), int(counts.min()) if len(counts) else 0\n",
    "    between = (counts * (grouped.mean() - table['response'].mean()) ** 2).sum()\n",
    "    return float(between / total), len(counts), int(counts.min())\n",
    "\n",
    "records = []\n",
    "for variable in predictor_columns:\n",
    "    values = screening_df[variable]\n",
    "    numeric = pd.api.types.is_numeric_dtype(values) and variable not in categorical_codes\n",
    "    record = {\n",
    "        'variable': variable,\n",
    "        'source': 'Original six' if variable in ORIGINAL_CANDIDATES else 'Other predictors',\n",
    "        'type': 'Numeric / ordered' if numeric else 'Categorical',\n",
    "        'missing_n': int(values.isna().sum()),\n",
    "        'missing_pct': 100 * values.isna().mean(),\n",
    "        'n_used': int(values.notna().sum()),\n",
    "        'pearson_price': np.nan, 'pearson_log_price': np.nan,\n",
    "        'spearman': np.nan, 'eta2_price': np.nan, 'eta2_log_price': np.nan,\n",
    "        'levels': np.nan, 'smallest_group': np.nan,\n",
    "        'passes_screen': False, 'note': ''\n",
    "    }\n",
    "    if values.isna().mean() > MISSING_CUTOFF:\n",
    "        record['note'] = 'Excluded by missingness cutoff'\n",
    "    elif values.nunique(dropna=True) < 2:\n",
    "        record['note'] = 'No variation'\n",
    "    elif numeric:\n",
    "        record['pearson_price'] = values.corr(screening_df['SalePrice'])\n",
    "        record['pearson_log_price'] = values.corr(log_price)\n",
    "        record['spearman'] = values.corr(log_price, method='spearman')\n",
    "        record['passes_screen'] = bool(abs(record['pearson_log_price']) >= PEARSON_CUTOFF)\n",
    "        if not record['passes_screen'] and abs(record['spearman']) >= PEARSON_CUTOFF:\n",
    "            record['note'] = 'Spearman magnitude exceeds the screening threshold'\n",
    "    else:\n",
    "        record['eta2_price'], _, _ = eta_squared(values, screening_df['SalePrice'])\n",
    "        record['eta2_log_price'], record['levels'], record['smallest_group'] = eta_squared(values, log_price)\n",
    "        record['passes_screen'] = bool(record['eta2_log_price'] >= ETA_SQUARED_CUTOFF)\n",
    "        if record['smallest_group'] < 5:\n",
    "            record['note'] = 'Smallest category contains fewer than 5 homes'\n",
    "    records.append(record)\n"
   ]
