  {
   "cell_type": "code",
   "execution_count": null,
   "id": "sampling-checks",
   "metadata": {},
   "outputs": [],
   "source": [
    "def sampling_diagnostics(name, fitted):\n",
    "    variables = ['alpha', 'beta', 'sigma']\n",
    "    if 'neighborhood_sd' in fitted.posterior:\n",
    "        variables += ['neighborhood_sd', 'neighborhood_z']\n",
    "    filename = name.lower().replace(' ', '_')\n",
    "    az.summary(fitted, var_names=variables, hdi_prob=0.90, round_to=4).to_csv(\n",
    "        results_path / f'{filename}_parameter_summary.csv'\n",
    "    )\n",
    "    max_rhat = float(az.rhat(fitted, var_names=variables).to_array().max())\n",
    "    min_bulk_ess = float(az.ess(fitted, var_names=variables, method='bulk').to_array().min())\n",
    "    min_tail_ess = float(az.ess(fitted, var_names=variables, method='tail').to_array().min())\n",
    "    divergences = int(fitted.sample_stats['diverging'].sum())\n",
    "    return {\n",
    "        'model': name, 'max_rhat': max_rhat, 'min_bulk_ess': min_bulk_ess,\n",
    "        'min_tail_ess': min_tail_ess, 'divergences': divergences,\n",
    "        'sampling_check': max_rhat < 1.01 and min_bulk_ess >= 400\n",
    "                          and min_tail_ess >= 400 and divergences == 0\n",
    "    }\n",
    "\n",
    "diagnostics = pd.DataFrame([\n",
    "    sampling_diagnostics(name, fitted) for name, fitted in fits.items()\n",
    "])\n",
    "display(diagnostics.round(3))\n",
    "diagnostics.to_csv(results_path / 'sampling_diagnostics.csv', index=False)\n"
