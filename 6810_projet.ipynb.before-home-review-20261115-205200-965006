  {
   "cell_type": "code",
   "execution_count": null,
   "id": "input-checks",
   "metadata": {},
   "outputs": [],
   "source": [
    "import pymc as pm\n",
    "import arviz as az\n",
    "\n",
    "results_path = path.parent / 'analysis_results'\n",
    "results_path.mkdir(exist_ok=True)\n",
    "\n",
    "transformation_check = pd.DataFrame({\n",
    "    'predictor': ['LotArea', 'log(LotArea)'],\n",
    "    'pearson_log_price': [\n",
    "        screening_df['LotArea'].corr(log_price),\n",
    "        np.log(screening_df['LotArea']).corr(log_price)\n",
    "    ]\n",
    "})\n",
    "display(transformation_check.round(3))\n",
    "\n",
    "overlap_pairs = [('GarageCars', 'GarageArea'), ('GrLivArea', 'TotRmsAbvGrd'),\n",
