   "id": "heldout-evaluation",
   "metadata": {},
   "outputs": [],
   "source": [
    "def prediction_metrics(table):\n",
    "    actual = table['actual_price'].to_numpy()\n",
    "    predicted = table['predicted_mean'].to_numpy()\n",
    "    return {\n",
    "        'n_homes': len(table),\n",
    "        'RMSE_dollars': np.sqrt(np.mean((actual - predicted) ** 2)),\n",
    "        'MAE_dollars': np.mean(np.abs(actual - predicted)),\n",
    "        'log_RMSE': np.sqrt(np.mean((np.log(actual) - np.log(predicted)) ** 2)),\n",
    "        'coverage_90_pct': 100 * np.mean(\n",
    "            (actual >= table['lower_90']) & (actual <= table['upper_90'])\n",
    "        ),\n",
    "        'mean_interval_width_dollars': (table['upper_90'] - table['lower_90']).mean()\n",
    "    }\n",
    "\n",
    "def evaluate_model(name, fitted, feature_names, held_features, seed):\n",
    "    mu, log_draws, price_draws, mean_price = predictive_draws(\n",
    "        fitted, feature_names, held_features, holdout_df, seed\n",
    "    )\n",
    "    lower, median, upper = np.quantile(price_draws, [0.05, 0.50, 0.95], axis=0)\n",
    "    table = pd.DataFrame({\n",
    "        'Id': holdout_df['Id'].to_numpy(), 'actual_price': y_holdout,\n",
    "        'predicted_mean': mean_price, 'predicted_median': median,\n",
    "        'lower_90': lower, 'upper_90': upper\n",
    "    })\n",
    "    table.to_csv(results_path / f'{name.lower().replace(\" \", \"_\")}_holdout_predictions.csv', index=False)\n",
    "    return {'table': table, 'mu': mu, 'log_draws': log_draws}\n",
    "\n",
    "predictions = {}\n",
    "for name, fitted, feature_names, seed in [\n",
    "    ('Baseline', baseline_fit, baseline_features, SEED + 1),\n",
    "    ('Expanded', expanded_fit, expanded_features, SEED + 2)\n",
    "]:\n",
    "    predictions[name] = evaluate_model(name, fitted, feature_names, X_holdout, seed)\n",
    "\n",
    "comparison = pd.DataFrame([\n",
    "    {'model': name, **prediction_metrics(output['table'])}\n",
    "    for name, output in predictions.items()\n",
    "]).set_index('model')\n",
    "display(comparison.round(3))\n",
    "comparison.to_csv(results_path / 'model_comparison.csv')\n"
   ]
