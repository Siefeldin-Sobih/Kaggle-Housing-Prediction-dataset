  {
   "cell_type": "markdown",
   "id": "model-definition-intro",
   "metadata": {},
   "source": [
    "## Define the Bayesian models\n",
    "\n",
    "Use log price with standardized predictors. Add a shared neighborhood model for partial pooling.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "model-definition",
   "metadata": {},
   "outputs": [],
   "source": [
    "CHAINS = 4\n",
    "DRAWS = 1000\n",
    "TUNE = 1500\n",
    "TARGET_ACCEPT = 0.95\n",
    "SEED = 6810\n",
    "\n",
    "def fit_price_model(feature_names, hierarchical=False, train_features=None):\n",
    "    inputs = X_train if train_features is None else train_features\n",
    "    coords = {'feature': feature_names, 'home': screening_df['Id'].to_numpy()}\n",
    "    if hierarchical:\n",
    "        coords['neighborhood'] = neighborhood_names\n",
    "    with pm.Model(coords=coords) as model:\n",
    "        alpha = pm.Normal('alpha', mu=float(y_train.mean()), sigma=0.7)\n",
    "        beta = pm.Normal('beta', mu=0.0, sigma=0.5, dims='feature')\n",
    "        sigma = pm.HalfNormal('sigma', sigma=0.5)\n",
    "        mu = alpha + pm.math.dot(inputs[feature_names].to_numpy(), beta)\n",
    "        if hierarchical:\n",
    "            neighborhood_sd = pm.HalfNormal('neighborhood_sd', sigma=0.3)\n",
    "            neighborhood_z = pm.ZeroSumNormal('neighborhood_z', sigma=1.0,\n",
    "                                              dims='neighborhood')\n",
    "            effects = pm.Deterministic('neighborhood_effect',\n",
    "                                       neighborhood_z * neighborhood_sd,\n",
    "                                       dims='neighborhood')\n",
    "            mu = mu + effects[train_neighborhood]\n",
    "        pm.Normal('log_price_obs', mu=mu, sigma=sigma, observed=y_train, dims='home')\n",
    "        prior = pm.sample_prior_predictive(draws=200, random_seed=SEED)\n",
    "        posterior = pm.sample(\n",
    "            draws=DRAWS, tune=TUNE, chains=CHAINS, cores=2,\n",
    "            target_accept=TARGET_ACCEPT, random_seed=SEED,\n",
    "            blas_cores=1, progressbar=True\n",
    "        )\n",
    "    return model, posterior, prior\n"
   ]
  },
