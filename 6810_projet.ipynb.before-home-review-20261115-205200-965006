   "cell_type": "markdown",
   "id": "model-inputs-intro",
   "metadata": {},
   "source": [
    "## Prepare the model inputs\n",
    "\n",
    "Score kitchen quality from 1 to 5. Fill numeric gaps and standardize inputs using the training sample, then apply the same settings to the held-out homes.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "model-inputs",
   "metadata": {},
   "outputs": [],
   "source": [
    "kitchen_scores = {'Po': 1, 'Fa': 2, 'TA': 3, 'Gd': 4, 'Ex': 5}\n",
    "baseline_features = ['GrLivArea', 'OverallQual', 'YearBuilt']\n",
    "expanded_features = baseline_features + [\n",
    "    'LogLotArea', 'GarageCars', 'TotalBsmtSF', 'KitchenQualityScore'\n",
    "]\n",
    "\n",
    "def model_features(frame):\n",
    "    features = frame[baseline_features + ['GarageCars', 'TotalBsmtSF']].astype(float).copy()\n",
    "    if not frame['LotArea'].dropna().gt(0).all():\n",
    "        raise ValueError('LotArea must be positive for the log transformation.')\n",
    "    features['LogLotArea'] = np.log(frame['LotArea'])\n",
    "    known_ratings = frame['KitchenQual'].dropna()\n",
    "    if not known_ratings.isin(kitchen_scores).all():\n",
    "        raise ValueError('Unexpected KitchenQual category.')\n",
    "    features['KitchenQualityScore'] = frame['KitchenQual'].map(kitchen_scores).astype(float)\n",
    "    return features[expanded_features]\n",
    "\n",
    "# Imputation and standardization use the training sample.\n",
    "features_train = model_features(screening_df)\n",
    "features_holdout = model_features(holdout_df)\n",
    "training_medians = features_train.median()\n",
    "features_train = features_train.fillna(training_medians)\n",
    "features_holdout = features_holdout.fillna(training_medians)\n",
    "feature_means = features_train.mean()\n",
    "feature_scales = features_train.std(ddof=0)\n",
    "if feature_scales.le(0).any() or features_train.isna().any().any():\n",
    "    raise ValueError('Check constant or entirely missing model inputs.')\n",
    "X_train = (features_train - feature_means) / feature_scales\n",
    "X_holdout = (features_holdout - feature_means) / feature_scales\n",
    "y_train = np.log(screening_df['SalePrice'].to_numpy(dtype=float))\n",
    "y_holdout = holdout_df['SalePrice'].to_numpy(dtype=float)\n",
    "\n",
    "neighborhood_names = sorted(screening_df['Neighborhood'].unique())\n",
    "neighborhood_index = {name: i for i, name in enumerate(neighborhood_names)}\n",
    "train_neighborhood = screening_df['Neighborhood'].map(neighborhood_index).to_numpy(dtype=int)\n",
    "holdout_neighborhood = holdout_df['Neighborhood'].map(neighborhood_index).fillna(-1).to_numpy(dtype=int)\n",
    "\n",
    "preprocessing_table = pd.DataFrame({\n",
    "    'imputation_median': training_medians,\n",
    "    'training_mean': feature_means, 'training_sd': feature_scales\n",
    "})\n",
